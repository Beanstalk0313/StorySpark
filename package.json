{
  "name": "storyspark",
  "private": true,
  "version": "6.2.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build": "tsc electron/main.ts --module esnext --target esnext --moduleResolution node --esModuleInterop --skipLibCheck --outDir electron",
    "electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron:build && electron .\"",
    "dist:electron": "npm run build && npm run electron:build && electron-builder"
  },
  "build": {
    "appId": "com.storyspark.app",
    "productName": "StorySpark",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "storyspark.png"
    ],
    "win": {
      "icon": "storyspark.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "StorySpark"
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "docx": "^8.5.0",
    "electron-store": "^11.0.2",
    "firebase": "^12.6.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "mammoth": "1.6.0",
    "pdfjs-dist": "3.11.174",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
